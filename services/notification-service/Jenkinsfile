pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Optional Docker image tag. Leave empty to use Jenkins BUILD_NUMBER.'
        )
    }

    environment {
        SERVICE_NAME   = 'notification-service'
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '027742774373'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO     = "${ECR_REGISTRY}/${SERVICE_NAME}"

        IMAGE_TAG = "${params.IMAGE_TAG?.trim() ?: env.BUILD_NUMBER}"

        EKS_CLUSTER = 'osp-labs-eks-cluster'

        GITOPS_REPO = 'https://github.com/shiva-555/osp-labs.git'
    }

    stages {

        stage('Initialize') {
            steps {
                echo """
                ==========================================
                NOTIFICATION SERVICE CI
                ==========================================
                Service        : ${SERVICE_NAME}
                Branch         : ${BRANCH_NAME}
                Build Number   : ${BUILD_NUMBER}
                AWS Region     : ${AWS_REGION}
                AWS Account    : ${AWS_ACCOUNT_ID}
                ECR Repository : ${ECR_REPO}
                Image Tag      : ${IMAGE_TAG}
                EKS Cluster    : ${EKS_CLUSTER}
                GitOps Repo    : ${GITOPS_REPO}
                ==========================================
                """
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: '''
                            if git rev-parse HEAD~1 >/dev/null 2>&1; then
                                git diff --name-only HEAD~1 HEAD |
                                grep "^services/notification-service/" || true
                            else
                                echo "FIRST_BUILD"
                            fi
                        ''',
                        returnStdout: true
                    ).trim()

                    if (changedFiles == 'FIRST_BUILD' || changedFiles) {
                        env.SERVICE_CHANGED = 'true'

                        echo """
                        Changes detected in ${SERVICE_NAME}.

                        Changed files:
                        ${changedFiles}
                        """
                    } else {
                        env.SERVICE_CHANGED = 'false'

                        echo "No changes detected for ${SERVICE_NAME}."
                    }
                }
            }
        }

        stage('Install Dependencies') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                dir("services/${SERVICE_NAME}") {
                    sh 'npm ci'
                }
            }
        }

        stage('Unit Test') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                dir("services/${SERVICE_NAME}") {
                    echo "Unit tests are currently not enabled."
                }
            }
        }

        stage('Trivy Scan') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                dir("services/${SERVICE_NAME}") {
                    sh '''
                        trivy fs \
                            --severity HIGH,CRITICAL \
                            --exit-code 1 \
                            .
                    '''
                }
            }
        }

        stage('Docker Build') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                dir("services/${SERVICE_NAME}") {
                    sh """
                        docker build \
                            -t ${ECR_REPO}:${IMAGE_TAG} \
                            .
                    """
                }
            }
        }

        stage('Docker Image Check') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                sh """
                    docker images \
                        ${ECR_REPO} \
                        --format 'table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}'
                """
            }
        }

        stage('ECR Login') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                sh """
                    aws ecr get-login-password \
                        --region ${AWS_REGION} |
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                """
            }
        }

        stage('Push Image to ECR') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                sh """
                    docker push \
                        ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Verify ECR Image') {
            when {
                environment name: 'SERVICE_CHANGED', value: 'true'
            }

            steps {
                sh """
                    aws ecr describe-images \
                        --repository-name ${SERVICE_NAME} \
                        --image-ids imageTag=${IMAGE_TAG} \
                        --region ${AWS_REGION}
                """
            }
        }
    }

    post {

        always {
            sh """
                docker rmi \
                    ${ECR_REPO}:${IMAGE_TAG} \
                    || true
            """
        }

        success {
            echo """
            ==========================================
            PIPELINE SUCCESSFUL
            ==========================================

            Service : ${SERVICE_NAME}
            Image   : ${ECR_REPO}:${IMAGE_TAG}

            Docker image successfully built and
            pushed to Amazon ECR.

            CD will use:

            Jenkins
                |
                v
            GitOps Repository
                |
                v
            ArgoCD
                |
                v
            EKS

            ==========================================
            """
        }

        failure {
            echo """
            ==========================================
            PIPELINE FAILED
            ==========================================

            Service      : ${SERVICE_NAME}
            Build Number : ${BUILD_NUMBER}
            Branch       : ${BRANCH_NAME}

            Check the failed stage in Jenkins.

            ==========================================
            """
        }
    }
}
