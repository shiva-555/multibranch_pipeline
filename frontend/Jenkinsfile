pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Optional Docker image tag. Leave empty to use Jenkins BUILD_NUMBER.'
        )
    }

    environment {
        SERVICE_NAME   = 'frontend'
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '027742774373'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO     = "${ECR_REGISTRY}/${SERVICE_NAME}"

        IMAGE_TAG = "${params.IMAGE_TAG?.trim() ?: env.BUILD_NUMBER}"

        EKS_CLUSTER = 'osp-labs-eks-cluster'

        GITOPS_REPO = 'https://github.com/shiva-555/osp-labs.git'

        REACT_APP_API_BASE_URL = '/api'
    }

    stages {

        stage('Initialize') {
            steps {
                echo """
                ==========================================
                FRONTEND CI
                ==========================================
                Service        : ${SERVICE_NAME}
                Branch         : ${BRANCH_NAME}
                Build Number   : ${BUILD_NUMBER}
                AWS Region     : ${AWS_REGION}
                AWS Account    : ${AWS_ACCOUNT_ID}
                ECR Repository : ${ECR_REPO}
                Image Tag      : ${IMAGE_TAG}
                EKS Cluster    : ${EKS_CLUSTER}
                GitOps Repo    : ${GITOPS_REPO}
                API Base URL   : ${REACT_APP_API_BASE_URL}
                ==========================================
                """
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('frontend') {
                    echo "Frontend unit tests are currently not enabled."
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir('frontend') {
                    sh '''
                        trivy fs \
                            --severity HIGH,CRITICAL \
                            --exit-code 0 \
                            .
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh """
                        docker build \
                            --build-arg REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL} \
                            -t ${ECR_REPO}:${IMAGE_TAG} \
                            .
                    """
                }
            }
        }

        stage('Docker Image Scan') {
            steps {
                sh """
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        --format table \
                        -o trivy-image-report.txt \
                        ${ECR_REPO}:${IMAGE_TAG}
                """

                sh 'cat trivy-image-report.txt'

                archiveArtifacts artifacts: 'trivy-image-report.txt', allowEmptyArchive: true
            }
        }

        stage('Docker Image Check') {
            steps {
                sh """
                    docker images \
                        ${ECR_REPO} \
                        --format 'table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}'
                """
            }
        }

        stage('ECR Login') {
            steps {
                sh """
                    aws ecr get-login-password \
                        --region ${AWS_REGION} |
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                """
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh """
                    docker push \
                        ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Verify ECR Image') {
            steps {
                sh """
                    aws ecr describe-images \
                        --repository-name ${SERVICE_NAME} \
                        --image-ids imageTag=${IMAGE_TAG} \
                        --region ${AWS_REGION}
                """
            }
        }

        stage('Summary') {
            steps {
                echo """
                ==========================================
                FRONTEND CI COMPLETED
                ==========================================

                Service : ${SERVICE_NAME}
                Image   : ${ECR_REPO}:${IMAGE_TAG}
                ECR     : SUCCESS

                Next:

                ECR
                 |
                 v
                GitOps Repository
                 |
                 v
                ArgoCD
                 |
                 v
                EKS

                ==========================================
                """
            }
        }
    }

    post {

        always {
            sh """
                docker image inspect ${ECR_REPO}:${IMAGE_TAG} >/dev/null 2>&1 &&
                docker rmi ${ECR_REPO}:${IMAGE_TAG} ||
                true
            """
        }

        success {
            echo """
            ==========================================
            FRONTEND PIPELINE SUCCESSFUL
            ==========================================

            Service : ${SERVICE_NAME}
            Image   : ${ECR_REPO}:${IMAGE_TAG}

            Docker image successfully built and
            pushed to Amazon ECR.

            CD flow:

            Jenkins
                |
                | Push image
                v
            Amazon ECR
                |
                | Image tag update
                v
            GitOps Repository
                |
                v
            ArgoCD
                |
                v
            EKS

            ==========================================
            """
        }

        failure {
            echo """
            ==========================================
            FRONTEND PIPELINE FAILED
            ==========================================

            Service      : ${SERVICE_NAME}
            Build Number : ${BUILD_NUMBER}
            Branch       : ${BRANCH_NAME}

            Check the failed stage in Jenkins.

            ==========================================
            """
        }
    }
}
